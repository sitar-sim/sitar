
#=========================================================
#  Compilation settings
#========================================================

#values passed by command line arguments. 
#*Don't set values here*:
#COMPILE_WITH_LOGGING   			
#COMPILE_FOR_PARALLEL_SIMULATION_WITH_OPENMP 	  


#settings that are *not* passed via command line (set values here) :
COMPILE_FOR_GDB_DEBUGGING			= True 
COMPILE_TO_IGNORE_ASSERTIONS			= False
OPTIMIZATION_LEVEL				= 2
COMPILE_TO_SHARED_LIBRARY 			= False	
COMPILE_STATIC_VERSION				= False
COMPILE_FOR_32_bit				= False
ADDITIONAL_FLAGS				= "-Wno-implicit-fallthrough" # " -std=c++0x"
#------------------------------------------------------------



if(not(OPTIMIZATION_LEVEL==0 or OPTIMIZATION_LEVEL==1 or OPTIMIZATION_LEVEL==2 or OPTIMIZATION_LEVEL ==3 )) :
	print("Incorrect optimization level specified in SConstruct file for SITAR compilation")
	exit()


#Read settings from config file
import os, glob
print("reading options from sitar_scons_config.txt...")
config_file="./sitar_scons_config.txt"
DIRS = [line.strip() for line in open(config_file, "r")]
SITAR_INSTALLATION_DIR=DIRS.pop(0)
TARGET_NAME=DIRS.pop(0)
MAIN_FILE_NAME=DIRS.pop(0)
enable_openmp=DIRS.pop(0)
if("True" in enable_openmp):
	COMPILE_FOR_PARALLEL_SIMULATION_WITH_OPENMP=True
else:
	COMPILE_FOR_PARALLEL_SIMULATION_WITH_OPENMP=False
enable_logging=DIRS.pop(0)
if("True" in enable_logging):
	COMPILE_WITH_LOGGING=True
else:
	COMPILE_WITH_LOGGING=False

additional_flags=DIRS.pop(0)
if additional_flags:
	ADDITIONAL_FLAGS += " " + additional_flags

#seventh line specifies extra libraries to link against (comma separated, no "-l" prefix)
extra_libs_line=DIRS.pop(0)
EXTRA_LIBS=[lib.strip() for lib in extra_libs_line.split(",") if lib.strip()]

#eighth line is the build directory (`sitar compile -b/--build-dir`),
#empty string if not given. See BUILD_DIR's own use below for what
#this changes.
BUILD_DIR=DIRS.pop(0)



#Check if sitar_Top.h exists
sitar_files= []
for item in DIRS:  
	sitar_files.extend(glob.glob(item+"/*.*"))

import sys
if not (any ("Top.h" in s for s in sitar_files)):
	print("\n=========================================")
	print("WARNING: No Top.h found!") 
	print("Did you forget to write a \"Top\" module?")
	print("The following files are included for compilation :")
	print(sitar_files)
	print("===========================================\n")
	sys.exit(1)
	




#Source files
#
#When BUILD_DIR is set, every source root below (the sitar core
#library, plus each -d directory) gets its own object-file
#subdirectory under it, via scons's VariantDir (duplicate=0, so
#sources are never physically copied -- only where the resulting .o
#lands changes). Without it, an object file compiles in place, next to
#its own .cpp -- e.g. <SITAR_INSTALLATION_DIR>core/*.o -- shared and
#reused as-is by every subsequent `sitar compile` invocation on this
#machine, for any project, regardless of whether that invocation's own
#flags (e.g. --logging/--no-logging) match: scons's dependency
#tracking here only looks at whether the .cpp source changed, not
#whether CCFLAGS did, so a stale, differently-flagged .o can silently
#get linked in -- a real ODR violation (mismatched class layouts
#across translation units, since e.g. sitar::logger's own member
#layout differs by SITAR_ENABLE_LOGGING), not a build error.
#
#CPPPATH always points at the *real* source directories regardless --
#duplicate=0 means headers are never copied into the build dir either,
#only .o output is remapped.
core_dir = SITAR_INSTALLATION_DIR+"core"

def variant_glob_root(index, original_dir):
	#Stable, collision-proof per-source-root build subdirectory name:
	#the index prefix guarantees uniqueness even if two -d directories
	#happen to share a basename; the basename itself is just for
	#readability in scons's own build-output messages.
	name = os.path.basename(original_dir.rstrip('/')) or "dir"
	return os.path.join(BUILD_DIR, "%d_%s" % (index, name))

if BUILD_DIR:
	core_glob_root = os.path.join(BUILD_DIR, "core")
	VariantDir(core_glob_root, core_dir, duplicate=0)
else:
	core_glob_root = core_dir

#The main file (-m/--main_file) is a single file, not a whole
#directory of sources like core/ and each -d below, but its .o needs
#the same build-dir treatment for the same reason -- otherwise it's
#the one object file still compiling in place, right next to whatever
#.cpp the caller pointed -m at.
if BUILD_DIR:
	main_dir  = os.path.dirname(MAIN_FILE_NAME) or "."
	main_root = os.path.join(BUILD_DIR, "main")
	VariantDir(main_root, main_dir, duplicate=0)
	main_file_source = os.path.join(main_root, os.path.basename(MAIN_FILE_NAME))
else:
	main_file_source = MAIN_FILE_NAME

Source=[ main_file_source,			 	#main.cpp
	Glob(core_glob_root+"/*.cpp")]      #sitar core files

Cpppath=[core_dir+"/"]

for i, item in enumerate(DIRS):
	if BUILD_DIR:
		glob_root = variant_glob_root(i, item)
		VariantDir(glob_root, item, duplicate=0)
	else:
		glob_root = item
	Source.append(Glob(glob_root+"/*.cpp"))
	Cpppath.append(item+"/")




print("\n============================================================")
print("scons messages:\n")





# Define compilation settings : 
env = Environment()
Libs=[]
Libpath=[]
Libs.extend(EXTRA_LIBS)		#libraries requested via `sitar compile -l/--libs`

#===========================================================
#compiler flags that are always enabled:
#===========================================================

env.Append(CCFLAGS = '-W')			#enable warnings
env.Append(CCFLAGS = '-Wall')			#enable warnings
env.Append(CCFLAGS =  '-O'+str(OPTIMIZATION_LEVEL))  	#optimization level
env.Append(CCFLAGS = '-pedantic')		#be pedantic in giving warnings
env.Append(CCFLAGS = ADDITIONAL_FLAGS)		#add ADDITIONAL_FLAGS



#===========================================================
#compiler flags settings
#===========================================================

if(COMPILE_STATIC_VERSION==True) :
	env.Append(LINKFLAGS =  '-static')
	env.Append(LINKFLAGS =  '-static-libgcc')
	env.Append(LINKFLAGS =  '-static-libstdc++')
	env.Append(CCFLAGS =  '-ffreestanding')


if(COMPILE_TO_IGNORE_ASSERTIONS==True) :
	env.Append(CCFLAGS =  '-DNDEBUG')
	#disable unused variable warnings when
	#assertions are removed
	#env.Append(CCFLAGS = '-Wno-unused-but-set-variable') 	
	#env.Append(CCFLAGS = '-Wno-uninitialized') 	


if(COMPILE_TO_SHARED_LIBRARY==True) :
	env.Append(CCFLAGS =  '-fPIC')
	env.Append(CCFLAGS =  '-DGENERATE_SHARED_LIBRARY_ONLY')

if(COMPILE_FOR_PARALLEL_SIMULATION_WITH_OPENMP==True) :
	env.Append(CCFLAGS =  '-fopenmp')
	Libs.append('gomp')

if(COMPILE_FOR_GDB_DEBUGGING==True) :
	env.Append(CCFLAGS = '-g')


if(COMPILE_FOR_32_bit==True) :
	env.Append(CCFLAGS =  '-m32')  	
	env.Append(LINKFLAGS =  '-m32')  


if(COMPILE_WITH_LOGGING==True) :	
	env.Append(CCFLAGS =  '-D SITAR_ENABLE_LOGGING')

	

##static:
#env.Append(CCFLAGS =  '-static')
##linker flags
#env.Append(LINKFLAGS =  '-static')





if ("DGENERATE_SHARED_LIBRARY_ONLY" in additional_flags):
	env.SharedLibrary(
		#executable name
		target=TARGET_NAME,
		
		#Source files
		source=Source,

		#paths to header files
		CPPPATH=Cpppath,

		#libraries to link with 
		LIBS=Libs,
		LIBPATH=Libpath
		#SHLIBPREFIX=''
		)

#Always generate an executable
#
#Default(...) below: without it, scons's own no-explicit-target default
#build set can fail to include this program at all when TARGET_NAME
#and/or a VariantDir'd source root lives outside the invocation's own
#directory tree (as they typically do here -- both are usually
#absolute paths elsewhere on disk), silently reporting "`.' is up to
#date" and building nothing rather than an error. Explicit beats
#implicit here.
program = env.Program(
		#executable name
		target=TARGET_NAME,

		#Source files
		source=Source,

		#paths to header files
		CPPPATH=Cpppath,

		#libraries to link with
		LIBS=Libs,
		LIBPATH=Libpath
		)
Default(program)

